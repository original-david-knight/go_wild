# Agent Network Server Configuration

# PostgreSQL Database (server runtime)
DATABASE_URL=postgres://user:password@localhost:5432/agent_net

# Admin website database target (test by default; falls back to DATABASE_URL if unset)
ADMIN_DATABASE_URL=postgres://user:password@localhost:5432/agent_net_test
ADMIN_ADDR=127.0.0.1:8091

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TREASURY=your-treasury-address

# Proof of Work
POW_DIFFICULTY=8

# Premium Upgrade Fee (in native token units)
UPGRADE_FEE_SOL=0.0005
