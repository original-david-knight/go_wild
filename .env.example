# Gemini API Key (required for agentic loop + web search via Grounding with Google Search)
GEMINI_API_KEY=

# Optional: SOCKS5 proxy for Polymarket CLOB requests (manager/broker host)
POLYMARKET_PROXY_URL=
# Optional: local broker Unix socket path used by manager + agent containers.
# Default is /tmp/gowild-broker/broker.sock.
BROKER_SOCKET_PATH=
# Public HTTPS URL for ingress-only webhooks/callbacks (for example, ngrok reserved domain)
INGRESS_PUBLIC_URL=
# Supplier provider defaults (for supplier_* tools when company override is not configured)
SUPPLIER_DEFAULT_PROVIDER=topdawg
TOPDAWG_API_KEY=
TOPDAWG_SUPPLIER_ID=
CJDROPSHIPPING_ACCESS_TOKEN=
CJDROPSHIPPING_PLATFORM_TOKEN=
CJDROPSHIPPING_DEFAULT_FROM_COUNTRY=CN
# Optional override for CJ API base URL (used for local testing/mocking)
CJDROPSHIPPING_BASE_URL=
# Optional: Polygon RPC for polymarket_redeem_winnings (defaults to https://polygon-rpc.com)
POLYMARKET_RPC_URL=

# Wallet Configuration (optional, for crypto features)
# Generate your own seed phrase - NEVER share or commit!
WALLET_SEED_PHRASE=
# These are derived from the seed phrase
WALLET_ETH_PRIVATE_KEY=
WALLET_SOL_PRIVATE_KEY=
# EVM RPC endpoint used by wallet tools (set to Polygon RPC for Polymarket on-chain actions)
WALLET_ETH_RPC_URL=
# Solana RPC endpoint used by wallet tools
WALLET_SOL_RPC_URL=

# Seed phrase for the Polymarket live-test wallet (polymarket/cmd/test_live).
# Deliberately separate from WALLET_SEED_PHRASE so live trading tests never
# silently use the shared agent wallet.
POLYMARKET_TEST_SEED_PHRASE=

# Database (optional, for agent_net and knowledge graph)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Context/chat retention (days; set to 0 to disable pruning)
GOWILD_CHAT_RETENTION_DAYS=30

# Solana (optional, for crypto features)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TREASURY=

# Local LLM (OpenAI-compatible endpoint, for delegation tasks)
LOCAL_LLM_URL=http://localhost:8000/v1

# Model used for lightweight tasks (web compression, etc.)
FAST_MODEL=gemini-3-flash-preview
CLAUDE_FAST_MODEL=claude-sonnet-4-6
CLAUDE_SMART_MODEL=claude-opus-4-7
# Codex config profiles from ~/.codex/config.toml (e.g. [profile.fast], [profile.smart])
CODEX_FAST_PROFILE=fast
CODEX_SMART_PROFILE=smart
