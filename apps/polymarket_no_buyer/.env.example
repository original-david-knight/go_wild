# Polymarket NO-signal / YES Buyer — environment template.
# Copy to .env (this folder) and fill in. Run the app from this directory so the
# .env here is picked up:  cd apps/polymarket_no_buyer && go run . --once --dry-run
# Variables already exported in your shell take precedence over this file.

# --- Required ---
# BIP39 mnemonic. The Ethereum key (account index 0) is derived from this and used
# for CLOB order signing, on-chain redemption, and the USDC balance read.
# This is an APP-SPECIFIC name (not the shared WALLET_SEED_PHRASE) so this app
# never accidentally trades with the repo's shared wallet. No fallback — required.
NO_BUYER_WALLET_SEED_PHRASE=

# --- Required: VPN proxy ---
# SOCKS5 proxy. ALL Polymarket access (CLOB, Gamma market data, and positions)
# routes through this — Polymarket is geo-restricted, so the proxy is mandatory and
# the app refuses to run without it. Usually shared in the repo-root .env (which
# this app also loads). e.g. socks5://127.0.0.1:1080
POLYMARKET_PROXY_URL=

# --- Optional: connection ---
# Polygon RPC for on-chain redeem transactions (falls back to WALLET_ETH_RPC_URL,
# then a public default).
POLYMARKET_RPC_URL=
# WALLET_ETH_RPC_URL=

# --- Optional: proxy/Gnosis-Safe funding (omit to trade from the EOA directly) ---
# POLYMARKET_FUNDER_ADDRESS=
# 0=EOA (default), 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE
# POLYMARKET_SIGNATURE_TYPE=0

# --- Optional: strategy overrides (defaults shown; flags override these) ---
# POLYMARKET_NO_BUYER_MODE=once
# POLYMARKET_NO_BUYER_INTERVAL=6h
# POLYMARKET_NO_BUYER_DRY_RUN=false
# Print skipped markets + reasons too (or pass --verbose):
# POLYMARKET_NO_BUYER_VERBOSE=false
# POLYMARKET_NO_BUYER_MIN_NO_MIDPOINT=0.89
# POLYMARKET_NO_BUYER_MAX_NO_MIDPOINT=0.99
# POLYMARKET_NO_BUYER_TARGET_EXPOSURE_PCT=0.01
# POLYMARKET_NO_BUYER_MIN_LIQUIDITY_USD=5000
# POLYMARKET_NO_BUYER_MIN_HOURS_TO_CLOSE=48h
# POLYMARKET_NO_BUYER_MAX_HOURS_TO_CLOSE=336h
# POLYMARKET_NO_BUYER_ORDER_EXPIRY_BEFORE_CLOSE=24h
# Polygon USDC token for the cash-balance read (defaults to USDC.e).
# POLYMARKET_NO_BUYER_USDC_TOKEN_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
