# Copy this file to .env and fill in your values
# cp .env.example .env

# Gemini API Key (required)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Blockchain Wallet Keys
# NOTE: Wallet keys are now stored per-agent in the database.
# Use the agent's database record to set wallet_eth_private_key and wallet_sol_private_key.
# Environment variables are only used as a fallback if no keys are in the database.
#
# The agent can only see public addresses and create signatures - private keys are never exposed.

# Ethereum (hex format, with or without 0x prefix) - FALLBACK ONLY
# WALLET_ETH_PRIVATE_KEY=0x...

# Solana (base58 format, 64-byte keypair) - FALLBACK ONLY
# WALLET_SOL_PRIVATE_KEY=...

# RPC Endpoints (optional - defaults to public endpoints)
# For production use, get your own RPC from Infura, Alchemy, Helius, etc.
# WALLET_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WALLET_SOL_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# AgentMail (optional - enables email tools)
# Get your key from: https://console.agentmail.to
# AGENTMAIL_API_KEY=your-api-key-here
